# Copia este archivo como .env para desarrollo local.
# Reemplaza este valor antes de usar sesiones o publicar la aplicación.
SECRET_KEY=cambiar-por-una-clave-aleatoria

# SQLite guarda qaa.sqlite3 dentro de la carpeta instance/ de Flask.
DATABASE_URL=sqlite:///qaa.sqlite3

# Flask usa este valor solamente para el servidor local de desarrollo.
FLASK_DEBUG=true

# Retención temporal de horarios con una solicitud pendiente.
PENDING_HOLD_MINUTES=15
